node_modules/
.DS_Store

# Self-signed WSS cert — regenerate locally with `npm run gen-cert`.
# The private key must never leave the machine; anyone holding it can
# impersonate the local agent to any browser that trusted this cert.
certs/*.key
certs/*.crt

# Scratch / debug output
*.log
/tmp/

# Anything mirrored from HIRA for reverse-engineering. These captures
# contain live session cookies and replayable signeddata.
recon/

# Private credentials, collection output and browser/network captures.
.env
.env.*
*.der
*.key
*.pem
*.p12
*.pfx
*.cms
*.har
*.jsonl
**/results.json
**/receipt.json
outputs/
downloads/
browser-profile/
playwright-report/
test-results/

# DDMD local runtime, vendor programs and private investigation evidence.
.local/
ddmd/gateway_poc/evidence/
ddmd/gateway_poc/private-downloads/
ddmd/gateway_poc/update/prepared.json
ddmd/gateway_poc/isolated-ui/app-launcher/launcher.m
__pycache__/
*.pyc
*.class
*.jar
*.exe
*.dll
*.db
*.db3
*.dat
*.zip
